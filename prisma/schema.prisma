// Data model — see docs/ARCHITECTURE.md §3 and docs/adr/0006-sharing-model.md
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")          // pooled — runtime queries
  directUrl = env("DATABASE_URL_UNPOOLED") // direct — schema push/migrations (Neon guidance)
}

enum Role {
  VIEWER
  EDITOR
}

enum RequestStatus {
  PENDING
  APPROVED
  DENIED
}

enum UserStatus {
  PENDING // signed up, waiting for an admin (ADR-0008)
  ACTIVE
}

model User {
  id           String          @id @default(cuid()) // seed users keep readable ids: alice, bob, carol
  email        String          @unique
  name         String
  passwordHash String? // bcrypt
  isAdmin      Boolean         @default(false)
  status       UserStatus      @default(ACTIVE)
  owned     Document[]
  shares    DocumentShare[]
  requests  AccessRequest[]
  uploads   Attachment[]
  versions  DocumentVersion[]
  comments  Comment[]
  createdAt DateTime        @default(now())
}

model Document {
  id          String          @id @default(cuid())
  title       String
  content     String          @default("") // sanitized HTML (ADR-0003)
  ownerId     String
  owner       User            @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  linkRole    Role? // null = link sharing off
  linkToken   String          @unique @default(cuid())
  shares      DocumentShare[]
  requests    AccessRequest[]
  attachments Attachment[]
  versions    DocumentVersion[]
  comments    Comment[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([ownerId, updatedAt])
}

model DocumentShare {
  documentId String
  userId     String
  role       Role
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@id([documentId, userId])
  @@index([userId])
}

model AccessRequest {
  id         String        @id @default(cuid())
  documentId String
  userId     String
  status     RequestStatus @default(PENDING)
  document   Document      @relation(fields: [documentId], references: [id], onDelete: Cascade)
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime      @default(now())

  @@index([documentId, status])
}

model Attachment {
  id           String   @id @default(cuid())
  documentId   String
  filename     String
  mimeType     String
  size         Int
  data         Bytes // ponytail: Postgres bytea, fine at ≤2 MB; move to object storage if files grow (ADR-0007)
  uploadedById String
  document     Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  uploadedBy   User     @relation(fields: [uploadedById], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())

  @@index([documentId])
}

// Version history (ADR-0009): a snapshot at most every 2 minutes of editing, plus one before every restore.
model DocumentVersion {
  id         String   @id @default(cuid())
  documentId String
  title      String
  content    String
  authorId   String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  author     User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@index([documentId, createdAt])
}

model Comment {
  id         String   @id @default(cuid())
  documentId String
  authorId   String
  body       String
  quote      String? // the text that was selected when commenting
  resolved   Boolean  @default(false)
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  author     User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@index([documentId, createdAt])
}
